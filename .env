# Control bot settings
CONTROL_BOT_TOKEN=
CONTROL_BOT_OWNER_ID=

# true => Telegram user auth flow runs via control bot chat (/auth)
TELEGRAM_AUTH_VIA_BOT=true

# Optional: control this userbot via your own Telegram bot
CONTROL_BOT_TOKEN=
CONTROL_BOT_OWNER_ID=

